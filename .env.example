# ArchScrape Deployment Environment Configuration
# Copy this template to .env and fill in your actual credentials.
# NEVER commit .env to version control.

# Google Places API (New) Key (Required for business existence check & identity)
GOOGLE_PLACES_API_KEY=

# Firecrawl API Key (Required for page discovery & scraping)
FIRECRAWL_API_KEY=

# OpenRouter API Key (Required for structured LLM factual extraction)
OPENROUTER_API_KEY=

# OpenRouter Primary Model (defaults to google/gemini-2.5-flash)
OPENROUTER_MODEL=google/gemini-2.5-flash

# OpenRouter Fallback Model (optional, e.g. meta-llama/llama-3.3-70b-instruct)
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct

# CORS Allowed Origins (comma-separated URLs for web frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Rate Limiting & Daily Caps
# RATE_LIMIT_PER_MINUTE=30
# DAILY_PLACES_CAP=1000
# DAILY_OPENROUTER_CAP=500
