# ArchScrape Environment Configuration
# Copy this file to .env and fill in your actual API keys.

# 1. Firecrawl API Key (https://firecrawl.dev)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# 2. Google Places API Key (Google Cloud Console with "Places API (New)" enabled)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# 3. (Optional) Custom Firecrawl API URL (defaults to https://api.firecrawl.dev)
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# 4. (Optional) Company Size Enrichment API Key
# COMPANY_SIZE_API_KEY=
